DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_NAME=mediconnect
DB_PORT=5432
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_APP_NAME=mediconnect-backend
BACKEND_PORT=5000
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost
JWT_SECRET=mediconnect_super_secret
JWT_ACCESS_SECRET=mediconnect_access_secret_change_me
JWT_REFRESH_SECRET=mediconnect_refresh_secret_change_me
DEFAULT_HOSPITAL_CODE=MCH-BLR
DB_POOL_MAX=20
API_RATE_LIMIT=120
JSON_BODY_LIMIT=2mb
MAX_UPLOAD_BYTES=12582912
UPLOADS_DIR=/app/uploads
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=
LOG_LEVEL=info
SMTP_HOST=
