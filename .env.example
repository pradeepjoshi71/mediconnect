# MediConnect .env — Production Variables

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=change_me_strong_password
DB_NAME=mediconnect
DB_PORT=5432
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_APP_NAME=mediconnect-backend
DB_POOL_MAX=20

# ── Application ───────────────────────────────────────────────────────────────
BACKEND_PORT=5000
CLIENT_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
NODE_ENV=production

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_min_32_chars_random_string
JWT_ACCESS_SECRET=change_me_min_32_chars_random_string
JWT_REFRESH_SECRET=change_me_min_32_chars_random_string

# ── Rate Limit ────────────────────────────────────────────────────────────────
# Nginx enforces the outer limit; this is the per-instance app-level limit.
API_RATE_LIMIT=300
JSON_BODY_LIMIT=2mb

# ── File Storage ──────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=12582912
UPLOADS_DIR=/app/uploads

# ── MinIO (Primary) ───────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=change_me_minio_user
MINIO_SECRET_KEY=change_me_minio_password
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# ── MinIO Backup (for mc mirror replication) ──────────────────────────────────
# Set these to enable real mc mirror storage replication.
# MINIO_PRIMARY_ALIAS is configured via minio-setup.sh on deployment.
MINIO_PRIMARY_ALIAS=mediconnect-primary
MINIO_BACKUP_ALIAS=mediconnect-backup
MINIO_BACKUP_ACCESS_KEY=change_me_backup_minio_user
MINIO_BACKUP_SECRET_KEY=change_me_backup_minio_password

# ── PostgreSQL Backup ─────────────────────────────────────────────────────────
# BACKUP_DIR must match the volume mount path in docker-compose.yml.
# In Docker: /backups (mounted as backups_data volume)
# In bare-metal: /var/backups/mediconnect
BACKUP_DIR=/backups
# PGPASSWORD is used by pg_dump for non-interactive auth — matches DB_PASSWORD.
PGPASSWORD=change_me_strong_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Notifications ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMS_PROVIDER=placeholder

# ── Misc ──────────────────────────────────────────────────────────────────────
DEFAULT_HOSPITAL_CODE=MCH-BLR
FIREBASE_SERVICE_ACCOUNT_JSON=
