{
  "name": "mediconnect-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file=../.env src/server.js",
    "start:cluster": "pm2 start ecosystem.config.js --env production",
    "test": "node src/scripts/runTestsWithInfraCheck.js",
    "test:unit": "node --env-file=../.env --test src/tests/*.test.js src/fhir/tests/fhir.mappers.test.js src/fhir/tests/fhir.schemas.test.js src/insurance/tests/insurance.repository.test.js",
    "test:integration": "node src/scripts/runTestsWithInfraCheck.js --integration",
    "dev": "node --env-file=../.env --watch --watch-path=src src/server.js",
    "db:create": "node --env-file=../.env src/scripts/createDb.js",
    "db:fix-phone": "node --env-file=../.env src/scripts/fixPhoneCol.js",
    "db:migrate": "node --env-file=../.env src/scripts/runMigration.js",
    "db:seed": "node --env-file=../.env ../scripts/seedBetaClinic.js",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed",
    "qa:investigate": "node --env-file=../.env src/scripts/qa_investigation.js",
    "qa:test": "node --env-file=../.env src/scripts/qa_full_test_suite.js",
    "qa:snapshot": "node --env-file=../.env src/scripts/check_pilot_data.js",
    "qa:seed": "node --env-file=../.env ../scripts/seedTestTenants.js",
    "qa:seed-bulk": "node --env-file=../.env ../scripts/seedBulkDemographics.js",
    "qa:seed-tx": "node --env-file=../.env ../scripts/seedWorkflowTransactions.js",
    "qa:validate-reports": "node --env-file=../.env ../scripts/validateReports.js",
    "qa:e2e-infra": "node --env-file=../.env ../scripts/e2eInfraSuite.js",
    "qa:validate-compliance": "node --env-file=../.env ../scripts/validateComplianceIntegrations.js",
    "qa:verify-rbac": "node --env-file=../.env ../scripts/verifyRbacAndTenantIsolation.js",
    "qa:validate-restore": "node --env-file=../.env src/scripts/validate_restore.js",
    "qa:load-test": "node --env-file=../.env ../scripts/runMultiTenantLoadTest.js",
    "qa:check-abha": "node --env-file=../.env ../scripts/checkPilotAbha.js",
    "qa:investigate-mch": "node --env-file=../.env ../scripts/investigateMchBlr.js",
    "qa:check-mch-history": "node --env-file=../.env ../scripts/checkMchBlrHistory.js",
    "qa:seed-mch": "node --env-file=../.env ../scripts/seedMchBlrTenant.js",
    "qa:e2e": "node --env-file=../.env src/scripts/e2e_qa_suite.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1064.0",
    "@aws-sdk/client-ses": "^3.1070.0",
    "@aws-sdk/s3-request-presigner": "^3.1064.0",
    "@sentry/node": "^10.56.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "firebase-admin": "^13.10.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "rate-limit-redis": "^4.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "winston": "^3.18.3",
    "zod": "^4.1.5"
  }
}
